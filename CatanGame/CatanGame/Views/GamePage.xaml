<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CatanGame.Views.GamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:CatanGame.Models"
    xmlns:vm="clr-namespace:CatanGame.ViewModels"
    Title="GamePage"
    x:DataType="vm:GamePageVM"
    IsBusy="{Binding IsBusy}">

    <HorizontalStackLayout>
        <Grid VerticalOptions="Center" HorizontalOptions="Center">
            <Button ImageSource="boardframe.png"
                    WidthRequest="445"
                    HeightRequest="445"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            <Grid VerticalOptions="Center"
                  HorizontalOptions="Center"
                  x:Name="grdBoard" />
            <Grid x:Name="grdPices"
                  HeightRequest="430"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  WidthRequest="430" />
        </Grid>
        <Grid RowDefinitions="auto,auto,auto"
              VerticalOptions="Center">
            <Label Text="{Binding Time}"
                   HorizontalOptions="Center" />
            <Label 
                   Text="{Binding StatusMessage}"
                   HorizontalOptions="Center"
                   Grid.Row="1" />
            <Button Command="{Binding EndTurnCommand}"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    Text="{x:Static m:Strings.EndTurn}"
                    Grid.Row="2" />
            <Button Command="{Binding EndTurnCommand}"
                    HeightRequest="50"
                    HorizontalOptions="Center"
                    Text="{x:Static m:Strings.EndTurn}"
                    Grid.Row="2" />
        </Grid>
    </HorizontalStackLayout>
</ContentPage>