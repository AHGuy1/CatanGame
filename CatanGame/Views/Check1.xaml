<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:CatanGame.Models"
             xmlns:vm="clr-namespace:CatanGame.ViewModels"
             x:Class="CatanGame.Views.Check1"
             x:DataType="vm:Check1VM"
             x:Name="Check"
             Title="Check1">
    <VerticalStackLayout>
        <Button
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            Command="{Binding Command}"
            CommandParameter="{x:Reference Check}"/>
    </VerticalStackLayout>
</ContentPage>