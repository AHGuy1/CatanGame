<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:m="clr-namespace:CatanGame.Models"
               xmlns:vm="clr-namespace:CatanGame.ViewModels"
               x:Class="CatanGame.Views.YearOfPlentyPage"
               x:Name="YearOfPlentyPopUp"
               x:DataType="vm:YearOfPlentyPageVM">
    <Border StrokeShape="RoundRectangle 30,30,30,30"
            BackgroundColor="#E6FFFFFF"
            Padding="20"
            WidthRequest="600"
            HeightRequest="300">
        <VerticalStackLayout>
            <Label Text="{x:Static m:Strings.SelectTwoCards}"
                   FontAttributes="Bold"
                   FontSize="26"
                   TextColor="DarkOrange"
                   HorizontalOptions="Center" />
            <Grid ColumnDefinitions="auto,auto,auto,auto,auto"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  ColumnSpacing="20">
                <ImageButton x:Name="WoodPickImage"
                             Source="{x:Static m:Strings.WoodImage}"
                             HeightRequest="110"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             BorderColor="Red"
                             WidthRequest="78"
                             CornerRadius="8"
                             Command="{Binding PickCardToGetCommand}"
                             CommandParameter="{x:Reference WoodPickImage}" />
                <Label Text="{Binding SelectedWoodCount}"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <ImageButton x:Name="BrickPickImage"
                             Source="{x:Static m:Strings.BrickImage}"
                             Grid.Column="1"
                             HeightRequest="110"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             BorderColor="Red"
                             WidthRequest="78"
                             CornerRadius="8"
                             Command="{Binding PickCardToGetCommand}"
                             CommandParameter="{x:Reference BrickPickImage}" />
                <Label Grid.Column="1"
                       Text="{Binding SelectedBrickCount}"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <ImageButton x:Name="SheepPickImage"
                             Source="{x:Static m:Strings.SheepImage}"
                             Grid.Column="2"
                             HeightRequest="110"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             BorderColor="Red"
                             WidthRequest="78"
                             CornerRadius="8"
                             Command="{Binding PickCardToGetCommand}"
                             CommandParameter="{x:Reference SheepPickImage}" />
                <Label Grid.Column="2"
                       Text="{Binding SelectedSheepCount}"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <ImageButton x:Name="WheatPickImage"
                             Source="{x:Static m:Strings.WheatImage}"
                             Grid.Column="3"
                             HeightRequest="110"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             BorderColor="Red"
                             WidthRequest="78"
                             CornerRadius="8"
                             Command="{Binding PickCardToGetCommand}"
                             CommandParameter="{x:Reference WheatPickImage}" />
                <Label Grid.Column="3"
                       Text="{Binding SelectedWheatCount}"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <ImageButton x:Name="OrePickImage"
                             Source="{x:Static m:Strings.OreImage}"
                             Grid.Column="4"
                             HeightRequest="110"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             BorderColor="Red"
                             WidthRequest="78"
                             CornerRadius="8"
                             Command="{Binding PickCardToGetCommand}"
                             CommandParameter="{x:Reference OrePickImage}" />
                <Label Grid.Column="4"
                       Text="{Binding SelectedOreCount}"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Grid>
            <Button Text="{x:Static m:Strings.ConfirmSelection}"
                    Grid.Column="1"
                    Command="{Binding ConfirmCommand}"
                    CommandParameter="{x:Reference YearOfPlentyPopUp}" />
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>